<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AYLink.Controls">
  <Design.PreviewWith>
    <Border Padding="20" Background="#2B2B2B">
      <StackPanel Spacing="4">
        <controls:BrowserTabItem Header="普通标签页" />
        <controls:BrowserTabItem Header="选中标签页" IsSelected="True" />
        <controls:BrowserTabItem Header="带图标标签页" IsLeftIconVisible="True" />
        <controls:BrowserTabItem Header="不可关闭" IsClosable="False" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- =============================== -->
  <!-- BrowserTabItem 基础样式 -->
  <!-- =============================== -->
  <Style Selector="controls|BrowserTabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Padding" Value="12,6,6,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MaxWidth" Value="240" />
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- 主容器 -->
          <Border Name="PART_LayoutRoot"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              
              <!-- 左侧功能按钮（如静音图标） -->
              <Button Name="PART_LeftActionButton"
                      Grid.Column="0"
                      Margin="0,0,6,0"
                      Width="20"
                      Height="20"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      CornerRadius="4"
                      IsVisible="{TemplateBinding IsLeftIconVisible}"
                      VerticalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="{TemplateBinding LeftActionTooltip}">
                <ContentPresenter Content="{TemplateBinding LeftIcon}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Button>

              <!-- 标题文本 -->
              <ContentPresenter Name="PART_ContentPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextWrapping="NoWrap"
                                RecognizesAccessKey="True" />

              <!-- 关闭按钮 -->
              <Button Name="PART_CloseButton"
                      Grid.Column="2"
                      Margin="4,0,0,0"
                      Width="20"
                      Height="20"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      CornerRadius="4"
                      IsVisible="{TemplateBinding IsClosable}"
                      VerticalAlignment="Center"
                      Opacity="0">
                <PathIcon Data="M7.116 8l-4.558 4.558.884.884L8 8.884l4.558 4.558.884-.884L8.884 8l4.558-4.558-.884-.884L8 7.116 3.442 2.558l-.884.884L7.116 8z"
                          Width="9" Height="9"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Button>
            </Grid>
          </Border>

          <!-- 右侧分隔符 -->
          <Border Name="PART_Separator"
                  Width="1"
                  Height="16"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                  Opacity="0.5"
                  Margin="0,0,-1,0" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- =============================== -->
  <!-- 悬浮状态 (PointerOver) -->
  <!-- =============================== -->
  <Style Selector="controls|BrowserTabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
  </Style>
  <Style Selector="controls|BrowserTabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <!-- 悬浮时显示关闭按钮 -->
  <Style Selector="controls|BrowserTabItem:pointerover /template/ Button#PART_CloseButton">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- 悬浮时隐藏分隔符 -->
  <Style Selector="controls|BrowserTabItem:pointerover /template/ Border#PART_Separator">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- =============================== -->
  <!-- 选中状态 (Selected) -->
  <!-- =============================== -->
  <Style Selector="controls|BrowserTabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
  </Style>
  <Style Selector="controls|BrowserTabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <!-- 选中时始终显示关闭按钮 -->
  <Style Selector="controls|BrowserTabItem:selected /template/ Button#PART_CloseButton">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- 选中时隐藏分隔符 -->
  <Style Selector="controls|BrowserTabItem:selected /template/ Border#PART_Separator">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- =============================== -->
  <!-- 拖拽状态 (Dragging) -->
  <!-- =============================== -->
  <Style Selector="controls|BrowserTabItem:dragging">
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="ZIndex" Value="100" />
  </Style>
  <Style Selector="controls|BrowserTabItem:dragging /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #40000000" />
  </Style>
  <Style Selector="controls|BrowserTabItem:dragging /template/ Border#PART_Separator">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- =============================== -->
  <!-- 关闭按钮悬浮效果 -->
  <!-- =============================== -->
  <Style Selector="controls|BrowserTabItem /template/ Button#PART_CloseButton">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="controls|BrowserTabItem /template/ Button#PART_CloseButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
  </Style>
  <Style Selector="controls|BrowserTabItem /template/ Button#PART_CloseButton:pressed">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
  </Style>

  <!-- =============================== -->
  <!-- 左侧操作按钮悬浮效果 -->
  <!-- =============================== -->
  <Style Selector="controls|BrowserTabItem /template/ Button#PART_LeftActionButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
  </Style>
  <Style Selector="controls|BrowserTabItem /template/ Button#PART_LeftActionButton:pressed">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
  </Style>

  <!-- =============================== -->
  <!-- 分隔符动画 -->
  <!-- =============================== -->
  <Style Selector="controls|BrowserTabItem /template/ Border#PART_Separator">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

</Styles>
