<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AYLink.Desktop.ViewModels.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AYLink.Desktop.Views.Pages.ScreenPage"
             x:DataType="vm:ScreenPageViewModel">

    <!-- 投屏标签页内容模板 -->
    <UserControl.Resources>
        <DataTemplate x:Key="ScreenTabContentTemplate" x:DataType="vm:ScreenTabViewModel">
            <Grid ColumnDefinitions="*,Auto">
                <!-- 串流区域 -->
                <Border Grid.Column="0">
                    <Grid>
                        <!-- 视频内容 -->
                        <Viewbox Stretch="Uniform">
                            <Grid>
                                <!-- 视频流 -->
                                <Image x:Name="VideoImage"/>
                            </Grid>
                        </Viewbox>

                        <!-- 展开侧边栏按钮 -->
                        <Button Width="40" Height="40"
                                ToolTip.Tip="展开侧边栏"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="10"
                                Opacity="0.6"
                                IsVisible="{Binding !IsSidebarVisible}"
                                Command="{Binding ToggleSidebarCommand}">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.ChevronLeft}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 侧边栏 -->
                <Grid Grid.Column="1" IsVisible="{Binding IsSidebarVisible}">
                    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="4"
                                    Spacing="4">

                            <!-- 收起按钮 -->
                            <Button Width="40" Height="40"
                                    ToolTip.Tip="收起侧边栏"
                                    Command="{Binding ToggleSidebarCommand}">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.ChevronRight}"/>
                            </Button>

                            <!-- 控制按钮 -->
                            <Button Width="40" Height="40" ToolTip.Tip="电源"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="Power">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Play}"/>
                            </Button>
                            <Button Width="40" Height="40" ToolTip.Tip="音量+"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="VolumeUp">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Add}"/>
                            </Button>
                            <Button Width="40" Height="40" ToolTip.Tip="音量-"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="VolumeDown">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Remove}"/>
                            </Button>
                            <Button Width="40" Height="40" ToolTip.Tip="静音"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="Mute">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Mute}"/>
                            </Button>
                            <Button Width="40" Height="40" ToolTip.Tip="亮屏"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="ScreenOn">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Star}"/>
                            </Button>
                            <Button Width="40" Height="40" ToolTip.Tip="熄屏"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="ScreenOff">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.StarOff}"/>
                            </Button>
                            <Button Width="40" Height="40" ToolTip.Tip="返回"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="Back">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Back}"/>
                            </Button>
                            <Button Width="40" Height="40" ToolTip.Tip="主页"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="Home">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Home}"/>
                            </Button>
                            <Button Width="40" Height="40" ToolTip.Tip="菜单"
                                    Command="{Binding SendKeyActionCommand}" CommandParameter="Menu">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.List}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 主容器 -->
    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <!-- 无设备标签页时的空状态 -->
            <StackPanel IsVisible="{Binding !Tabs.Count}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Opacity="0.5">
                <ui:SymbolIcon Symbol="Play" FontSize="64"/>
                <TextBlock Text="未选中设备"
                           HorizontalAlignment="Center"
                           Theme="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="请在首页选择一个设备来启动投屏"
                           HorizontalAlignment="Center"
                           Theme="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <!-- TabView: 设备投屏标签页 -->
            <ui:TabView TabItems="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         IsAddTabButtonVisible="False"
                         TabCloseRequested="TabView_TabCloseRequested"
                         SelectionChanged="TabView_SelectionChanged"
                         IsVisible="{Binding Tabs.Count}"
                         Background="Transparent">
                <ui:TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:ScreenTabViewModel">
                        <ui:TabViewItem Header="{Binding Title}"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource ScreenTabContentTemplate}"
                                        IsClosable="True"
                                        Background="Transparent"/>
                    </DataTemplate>
                </ui:TabView.TabItemTemplate>
            </ui:TabView>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1"
                Padding="12,4"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                x:CompileBindings="False">
            <TextBlock Text="{Binding SelectedTab.StatusMessage, FallbackValue='', TargetNullValue=''}"
                       Theme="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.6"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
