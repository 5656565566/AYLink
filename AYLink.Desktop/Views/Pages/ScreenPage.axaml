<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AYLink.Desktop.ViewModels.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:AYLink.Desktop.Views"
             xmlns:pages="using:AYLink.Desktop.Views.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AYLink.Desktop.Views.Pages.ScreenPage"
             x:DataType="vm:ScreenPageViewModel">

    <UserControl.Resources>
        <!-- 使用分离的 UserControl 作为数据模板的内容 -->
        <DataTemplate x:Key="ScreenTabContentTemplate" x:DataType="vm:ScreenTabViewModel">
            <pages:ScreenTabContentView />
        </DataTemplate>
    </UserControl.Resources>

    <views:TabbedPageView TabContentTemplate="{StaticResource ScreenTabContentTemplate}"
                          ShowStatusBar="False">
        <views:TabbedPageView.EmptyStateIcon>
            <ui:SymbolIcon Symbol="Play" FontSize="64"/>
        </views:TabbedPageView.EmptyStateIcon>
    </views:TabbedPageView>
</UserControl>