<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AYLink.Desktop.ViewModels.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:i18n="using:AYLink.Desktop.Services.Localization"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="760"
             x:Class="AYLink.Desktop.Views.Pages.ServerRemoteDeviceGroupsPage"
             x:DataType="vm:ServerRemoteDeviceGroupsPageViewModel">

    <UserControl.Styles>
        <Style Selector="Border.toolbar-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.group-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Border.metric-card">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinWidth" Value="96"/>
        </Style>
        <Style Selector="Border.editor-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="Border.selection-panel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.selection-item">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,6">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Command="{Binding BackToServerSettingsCommand}"
                        Padding="8,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:SymbolIcon Symbol="Back" FontSize="16"/>
                        <TextBlock Text="{i18n:Tr ServerSettings.BackToServerSettings, DefaultText='返回'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,60,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer IsVisible="{Binding !IsEditorOpen}">
                <StackPanel Margin="20" Spacing="12" MaxWidth="980">
                    <Border Classes="toolbar-card">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchKeyword}"
                                     Watermark="{i18n:Tr DeviceGroupsPage.GroupSearchPlaceholder, DefaultText='搜索分组名称或描述'}"
                                     MinHeight="34"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:SymbolIcon Symbol="Refresh" FontSize="15"/>
                                        <TextBlock Text="{i18n:Tr DeviceGroupsPage.Refresh, DefaultText='刷新'}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CreateGroupCommand}" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:SymbolIcon Symbol="Add" FontSize="15"/>
                                        <TextBlock Text="{i18n:Tr DeviceGroupsPage.CreateGroup, DefaultText='新建设备分组'}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !IsLoading}"/>
                    <TextBlock Text="{i18n:Tr ServerRemoteDeviceGroupsPage.Loading, DefaultText='加载中...'}"
                               IsVisible="{Binding IsLoading}"/>
                    <TextBlock Text="{i18n:Tr ServerRemoteDeviceGroupsPage.Empty, DefaultText='暂无设备分组'}"
                               IsVisible="{Binding HasEmptyState}"/>

                    <Border Classes="toolbar-card" IsVisible="{Binding HasVisibleGroups}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{i18n:Tr DeviceGroupsPage.GroupList, DefaultText='分组列表'}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FilteredGroupCount, StringFormat='共 {0} 个分组'}"
                                           Opacity="0.65"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RemoteDeviceGroupCardViewModel">
                                        <Border Classes="group-card" IsVisible="{Binding IsVisible}">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                            <Border IsVisible="{Binding IsSystem}"
                                                                    Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                                                    CornerRadius="4"
                                                                    Padding="6,2">
                                                                <TextBlock Text="{i18n:Tr DeviceGroupsPage.SystemGroup, DefaultText='系统内置'}"
                                                                           FontSize="11"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   IsVisible="{Binding HasDescription}"
                                                                   Opacity="0.78"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding EmptyDescription}"
                                                                   IsVisible="{Binding !HasDescription}"
                                                                   Opacity="0.55"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding SystemHint}"
                                                                   IsVisible="{Binding IsSystem}"
                                                                   Opacity="0.65"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                                        <Button Command="{Binding ManageCommand}" Padding="10,6">
                                                            <TextBlock Text="{Binding ManageButtonText}"/>
                                                        </Button>
                                                        <Button Command="{Binding DeleteCommand}"
                                                                IsEnabled="{Binding CanDelete}"
                                                                Padding="10,6">
                                                            <TextBlock Text="{i18n:Tr DeviceGroupsPage.DeleteGroup, DefaultText='删除'}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <WrapPanel Orientation="Horizontal" ItemWidth="110">
                                                    <Border Classes="metric-card">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{i18n:Tr DeviceGroupsPage.Devices, DefaultText='设备'}" FontSize="12" Opacity="0.65"/>
                                                            <TextBlock Text="{Binding DeviceCount}" FontSize="16" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="metric-card">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{i18n:Tr ServerRemoteDeviceGroupsPage.Roles, DefaultText='角色'}" FontSize="12" Opacity="0.65"/>
                                                            <TextBlock Text="{Binding RoleCount}" FontSize="16" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Classes="metric-card">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{i18n:Tr ServerRemoteDeviceGroupsPage.Users, DefaultText='用户'}" FontSize="12" Opacity="0.65"/>
                                                            <TextBlock Text="{Binding UserCount}" FontSize="16" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsEditorOpen}">
                <StackPanel Margin="20" Spacing="12" MaxWidth="980">
                    <Border Classes="editor-card">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Grid.Column="0"
                                        Command="{Binding BackToListCommand}"
                                        Padding="8,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ui:SymbolIcon Symbol="Back" FontSize="16"/>
                                        <TextBlock Text="{i18n:Tr DeviceGroupsPage.BackToList, DefaultText='返回分组列表'}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GroupEditorTitle}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,120,0"/>
                            </Grid>

                            <StackPanel Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{i18n:Tr DeviceGroupsPage.GroupName, DefaultText='分组名称'}" Opacity="0.75"/>
                                    <TextBox Text="{Binding EditingName}"
                                             IsEnabled="{Binding CanEditGroupForm}"
                                             Watermark="{i18n:Tr DeviceGroupsPage.GroupNameWatermark, DefaultText='分组名称'}"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{i18n:Tr DeviceGroupsPage.Description, DefaultText='描述'}" Opacity="0.75"/>
                                    <TextBox Text="{Binding EditingDescription}"
                                             IsEnabled="{Binding CanEditGroupForm}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="74"
                                             Watermark="{i18n:Tr DeviceGroupsPage.GroupDescriptionPlaceholder, DefaultText='可以写这个分组的用途或归属范围'}"/>
                                </StackPanel>

                                <Border IsVisible="{Binding IsEditingSystemGroup}"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="10">
                                    <TextBlock Text="{i18n:Tr ServerRemoteDeviceGroupsPage.SystemGroupEditHint, DefaultText='内置分组的名称和描述已锁定，你仍然可以在下面调整角色和用户的授权范围。'}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <Border Classes="selection-panel">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{i18n:Tr DeviceGroupsPage.Devices, DefaultText='设备'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedDeviceCount, StringFormat='已选择 {0} 项'}" Opacity="0.65" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox Text="{Binding DeviceSearchKeyword}"
                                             Watermark="{i18n:Tr ServerRemoteDeviceGroupsPage.DeviceSearchPlaceholder, DefaultText='搜索设备名称或序列号'}"
                                             IsVisible="{Binding !IsEditingSystemGroup}"/>

                                    <TextBlock Text="{i18n:Tr ServerRemoteDeviceGroupsPage.SystemGroupDeviceHint, DefaultText='这个系统内置组会自动包含全部设备，不能在这里手动增删设备。'}"
                                               IsVisible="{Binding IsEditingSystemGroup}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"/>

                                    <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding !IsEditingSystemGroup}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RemoteGroupDeviceSelectionItemViewModel">
                                                <Border Classes="selection-item" IsVisible="{Binding IsVisible}">
                                                    <CheckBox IsChecked="{Binding IsSelected}">
                                                        <StackPanel Spacing="2" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Meta}" Opacity="0.65" FontSize="12"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="selection-panel" IsVisible="{Binding CanManageAccounts}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{i18n:Tr ServerRemoteDeviceGroupsPage.Roles, DefaultText='角色'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedRoleCount, StringFormat='已选择 {0} 项'}" Opacity="0.65" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox Text="{Binding RoleSearchKeyword}"
                                             Watermark="{i18n:Tr ServerRemoteDeviceGroupsPage.RoleSearchPlaceholder, DefaultText='搜索角色名称或描述'}"/>

                                    <ItemsControl ItemsSource="{Binding Roles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RemoteGroupRoleSelectionItemViewModel">
                                                <Border Classes="selection-item" IsVisible="{Binding IsVisible}">
                                                    <CheckBox IsChecked="{Binding IsSelected}">
                                                        <StackPanel Spacing="2" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="selection-panel" IsVisible="{Binding CanManageAccounts}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{i18n:Tr ServerRemoteDeviceGroupsPage.Users, DefaultText='用户'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedUserCount, StringFormat='已选择 {0} 项'}" Opacity="0.65" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox Text="{Binding UserSearchKeyword}"
                                             Watermark="{i18n:Tr ServerRemoteDeviceGroupsPage.UserSearchPlaceholder, DefaultText='搜索用户名或角色'}"/>

                                    <ItemsControl ItemsSource="{Binding Users}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RemoteGroupUserSelectionItemViewModel">
                                                <Border Classes="selection-item" IsVisible="{Binding IsVisible}">
                                                    <CheckBox IsChecked="{Binding IsSelected}">
                                                        <StackPanel Spacing="2" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding RoleSummary}" Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Right">
                                <Button Command="{Binding SaveEditorCommand}"
                                        IsEnabled="{Binding CanSaveEditor}"
                                        MinWidth="92"
                                        HorizontalContentAlignment="Center">
                                    <TextBlock Text="{i18n:Tr DeviceGroupsPage.Save, DefaultText='保存'}"/>
                                </Button>
                                <Button Command="{Binding CloseEditorCommand}"
                                        IsEnabled="{Binding !IsSaving}"
                                        MinWidth="92"
                                        HorizontalContentAlignment="Center">
                                    <TextBlock Text="{i18n:Tr Dialog.Cancel, DefaultText='取消'}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
