<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AYLink.Desktop.ViewModels.Pages"
             xmlns:views="using:AYLink.Desktop.Views"
             xmlns:pages="using:AYLink.Desktop.Views.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="using:AYLink.Desktop.Converters"
             x:Class="AYLink.Desktop.Views.Pages.FilePage"
             x:DataType="vm:FilePageViewModel">
    <UserControl.Resources>
        <converters:FilePaneWidthConverter x:Key="PaneWidth"/>
        <DataTemplate x:Key="FileTabContentTemplate" x:DataType="vm:FileTabViewModel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding IsLeftPaneVisible, Converter={StaticResource PaneWidth}}"/>
                    <ColumnDefinition Width="{Binding IsRightPaneVisible, Converter={StaticResource PaneWidth}}"/>
                </Grid.ColumnDefinitions>
                <pages:FilePaneView Tab="{Binding}" Pane="{Binding LeftPane}" IsVisible="{Binding IsLeftPaneVisible}" ShowLayoutToggle="{Binding IsSingleLeft}"/>
                <pages:FilePaneView Grid.Column="1" Tab="{Binding}" Pane="{Binding RightPane}" IsVisible="{Binding IsRightPaneVisible}" ShowLayoutToggle="{Binding IsRightPaneVisible}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <views:TabbedPageView TabContentTemplate="{StaticResource FileTabContentTemplate}" ShowStatusBar="False">
        <views:TabbedPageView.EmptyStateIcon><ui:FASymbolIcon Symbol="Document" FontSize="64"/></views:TabbedPageView.EmptyStateIcon>
    </views:TabbedPageView>
</UserControl>
