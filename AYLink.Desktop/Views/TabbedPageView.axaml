<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:AYLink.Desktop.ViewModels"
             xmlns:local="using:AYLink.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AYLink.Desktop.Views.TabbedPageView"
             x:DataType="vm:ITabbedPageViewModel">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <ui:FATabView x:Name="PART_TabView"
                         TabItemsSource="{CompiledBinding Tabs}"
                         SelectedItem="{CompiledBinding SelectedTab}"
                         IsAddTabButtonVisible="False"
                         CanReorderTabs="False"
                         CanDragTabs="False"
                         TabCloseRequested="TabView_TabCloseRequested"
                         Background="Transparent"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch">
                <ui:FATabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:TabItemViewModelBase">
                        
                        <ui:FATabViewItem Header="{CompiledBinding Title}"
                                        Content="{CompiledBinding}"
                                        ContentTemplate="{CompiledBinding $parent[local:TabbedPageView].TabContentTemplate}"
                                        IsClosable="{CompiledBinding IsClosable}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                        
                    </DataTemplate>
                </ui:FATabView.TabItemTemplate>
            </ui:FATabView>

            <!-- 空标签页占位：作为独立的 TabView 覆盖在上方 仅当无功能标签页时显示 -->
            <ui:FATabView x:Name="PART_EmptyTabView"
                         IsVisible="False"
                         Background="Transparent"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         IsAddTabButtonVisible="False"
                         CanReorderTabs="False">
                <ui:FATabViewItem x:Name="PART_EmptyTabItem"
                                Header="{CompiledBinding $parent[local:TabbedPageView].EmptyTabTitle}"
                                IsClosable="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ui:FATabViewItem.Content>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    Opacity="0.5">
                            <ContentPresenter Content="{CompiledBinding $parent[local:TabbedPageView].EmptyStateIcon}"
                                              HorizontalAlignment="Center"/>
                            <TextBlock Text="{CompiledBinding EmptyStateTitle}"
                                       HorizontalAlignment="Center"
                                       Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{CompiledBinding EmptyStateDescription}"
                                       HorizontalAlignment="Center"
                                       Theme="{StaticResource BodyTextBlockStyle}"/>
                        </StackPanel>
                    </ui:FATabViewItem.Content>
                </ui:FATabViewItem>
            </ui:FATabView>
        </Grid>

        <Grid Grid.Row="1" IsVisible="{CompiledBinding $parent[local:TabbedPageView].ShowStatusBar}"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <!-- 深色底栏向上补齐凹圆角 与内容区的 8px 外圆角衔接 -->
            <Path Width="8" Height="8" Margin="0,-8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" IsHitTestVisible="False"
                  Data="M0,0 A8,8 0 0 0 8,8 L0,8 Z"/>
            <Path Width="8" Height="8" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" IsHitTestVisible="False"
                  Data="M8,0 A8,8 0 0 1 0,8 L8,8 Z"/>
            <Border Padding="12,4">
                <ContentPresenter Content="{CompiledBinding #PART_TabView.SelectedItem}"
                                  ContentTemplate="{CompiledBinding $parent[local:TabbedPageView].StatusBarTemplate}"
                                  IsVisible="{CompiledBinding #PART_TabView.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </Border>
            
        </Grid>
    </Grid>
</UserControl>
