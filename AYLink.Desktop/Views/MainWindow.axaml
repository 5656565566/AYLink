<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:AYLink.Desktop.ViewModels"
        xmlns:views="using:AYLink.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AYLink.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://AYLink.Desktop/Assets/avalonia-logo.ico"
        Title="安易连">

    <Grid>
        <ui:NavigationView x:Name="NavView"
                           PaneDisplayMode="Left"
                           SelectionChanged="NavView_OnSelectionChanged"
                           IsSettingsVisible="True">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="首页" Tag="Home" Margin="1.1">
                    <ui:NavigationViewItem.IconSource>
                        <ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Home}"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="文件管理" Tag="File" Margin="1.1">
                    <ui:NavigationViewItem.IconSource>
                        <ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Folder}"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="投屏" Tag="Screen" Margin="1.1">
                    <ui:NavigationViewItem.IconSource>
                        <ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Play}"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="应用管理" Tag="App" Margin="1.1">
                    <ui:NavigationViewItem.IconSource>
                        <ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Repair}"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="终端" Tag="Shell" Margin="1.1">
                    <ui:NavigationViewItem.IconSource>
                        <ui:SymbolIconSource Symbol="{x:Static ui:Symbol.Code}"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <!-- 内容区域：绑定 ViewModel 的 CurrentPage，通过 App.axaml 中的 DataTemplate 自动匹配 View -->
            <ContentControl Content="{Binding CurrentPage}"/>

        </ui:NavigationView>

        <!-- 消息弹出层，覆盖在最上层 -->
        <views:ToastHost />
    </Grid>
</Window>
